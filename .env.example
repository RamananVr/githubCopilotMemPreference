# Copy to .env and fill in values before running docker compose

# ── Required: path to your VS Code User storage directory ────────────────────
# Windows:  C:\Users\<you>\AppData\Roaming\Code\User
# macOS:    /Users/<you>/Library/Application Support/Code/User
# Linux:    /home/<you>/.config/Code/User
VSCODE_USER_DIR=

# ── Optional: Anthropic API key for LLM classification ───────────────────────
ANTHROPIC_API_KEY=
